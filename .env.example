# Doodle Dash — environment variables
# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.

# ── Pusher Channels (server) ────────────────────────────────────────────────
# Create a free app at https://pusher.com → Channels → App Keys
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ── Pusher Channels (client — must match server key & cluster above) ───────
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ── Session tokens (recommended in production) ─────────────────────────────
# Random string, 32+ chars. Used to sign player session JWTs.
# If unset, PUSHER_SECRET is used as a fallback (works but less ideal).
SESSION_SECRET=
